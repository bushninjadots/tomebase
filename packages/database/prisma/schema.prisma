// schema-cache-bust-2026-07-10

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  password  String?
  onboarded Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  teams     TeamMember[]
  sessions  Session[]
  accounts  Account[]
  comments  Comment[]
  bookmarks Bookmark[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  userId      String
  published    Boolean  @default(false)
  customDomain String?
  domainStatus String?  // pending | verified | failed | configuring
  domainVerifiedAt DateTime?
  domainLastCheckedAt DateTime?
  domainSslStatus String?  // provisioning | active | failed
  logoUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages     DocPage[]
  chatMessages ChatMessage[]
  apiKeys   ApiKey[]
  webhooks  Webhook[]
  healthReports HealthReport[]
  teamId    String?
  team      Team?      @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([customDomain])
}

model DocPage {
  id           String    @id @default(cuid())
  title        String
  slug         String
  content      String
  description  String?
  projectId    String
  parentId     String?
  order        Int       @default(0)
  published    Boolean   @default(false)
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       DocPage?        @relation("DocPageHierarchy", fields: [parentId], references: [id])
  children     DocPage[]       @relation("DocPageHierarchy")
  snapshots         PageSnapshot[]
  comments          Comment[]
  bookmarks         Bookmark[]
  scheduledPublish  ScheduledPublish?
  viewEvents        ViewEvent[]

  @@index([projectId])
  @@index([projectId, published])
}

model PageSnapshot {
  id        String   @id @default(cuid())
  pageId    String
  title     String
  content   String
  createdAt DateTime @default(now())

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  prefix    String  @default("")
  key       String    @unique
  projectId String
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  tier      String   @default("free")
  personal  Boolean  @default(false)

  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  stripeCancelAtPeriodEnd Boolean @default(false)
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     TeamMember[]
  projects    Project[]
  invitations Invitation[]
}

model TeamMember {
  id     String @id @default(cuid())
  role   String @default("member")
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("member")
  teamId    String
  token     String   @unique
  accepted  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  createdAt DateTime @default(now())

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId, createdAt])
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String?
  events    String   @default("page.created,page.updated,page.published")
  projectId String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ScheduledPublish {
  id          String   @id @default(cuid())
  pageId      String
  publishAt   DateTime
  unpublishAt DateTime?
  createdAt   DateTime @default(now())

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId])
  @@index([publishAt])
  @@index([unpublishAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  pageId    String
  userId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page    DocPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]  @relation("CommentReplies")

  @@index([pageId, createdAt])
}

model ViewEvent {
  id        String   @id @default(cuid())
  pageId    String
  visitorId String?
  referrer  String?
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([createdAt])
  @@index([visitorId])
}

model HealthReport {
  id         String   @id @default(cuid())
  projectId  String
  score      Int      // Overall health score 0-100
  totalPages Int
  issues     Json     // HealthIssue[] — individual issues found
  summary    Json     // Category breakdown (brokenLinks, orphans, stale, etc.)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
