{
  "name": "fluid",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:migrate:deploy": "turbo db:migrate:deploy",
    "db:migrate:status": "turbo db:migrate:status",
    "db:seed": "npx tsx scripts/seed-docs.ts",
    "test": "turbo test"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.20",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@plausible-analytics/tracker": "^0.4.5",
    "bcryptjs": "^3.0.3",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4"
  }
}
